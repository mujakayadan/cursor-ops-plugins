{
  "name": "cursor-ops-plugins",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Cursor plugin suite for GitHub, DigitalOcean, Vercel and AWS operations with tiered MCP servers, guardrail hooks, skills and evals, plus Copier project scaffolders.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "sync": "node scripts/sync-core.mjs",
    "check": "node scripts/sync-core.mjs --check && node scripts/validate.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "evals": "node evals/run.mjs policy contract",
    "evals:agent": "node evals/run.mjs agent",
    "ci": "pnpm run check && pnpm test && pnpm run evals",
    "install-local": "node scripts/sync-core.mjs && node scripts/install-local.mjs",
    "uninstall-local": "node scripts/install-local.mjs --uninstall",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "new-plugin": "node scripts/new-plugin.mjs",
    "templates:render": "node scripts/test-templates.mjs --render-only",
    "templates:test": "node scripts/test-templates.mjs"
  }
}
