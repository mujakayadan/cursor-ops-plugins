{
  "mcpServers": {
    "ops-inhouse-read": {
      "url": "http://127.0.0.1:47821/mcp/inhouse",
      "headers": {
        "Authorization": "Bearer ${env:OPS_MCP_TOKEN}"
      }
    },
    "ops-inhouse-write": {
      "command": "node",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/lib/core/run-mcp.ts",
        "--tier",
        "write"
      ]
    }
  }
}
