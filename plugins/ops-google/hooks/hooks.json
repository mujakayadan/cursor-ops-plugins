{
  "version": 1,
  "hooks": {
    "beforeMCPExecution": [
      {
        "command": "node ./lib/core/run-guard.ts beforeMCPExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./lib/core/run-guard.ts beforeShellExecution",
        "matcher": "\\bgog(\\.exe|\\.cmd)?\\s",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
