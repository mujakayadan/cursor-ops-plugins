{
  "version": 1,
  "hooks": {
    "beforeMCPExecution": [
      { "command": "node ./lib/core/run-guard.mjs beforeMCPExecution", "timeout": 10, "failClosed": true }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./lib/core/run-guard.mjs beforeShellExecution",
        "matcher": "\\b(pip3?|python3?|py|uv|poetry|pipenv|conda|npm|npx|yarn|bun|bunx|pnpm|gradle|mvnw?|copier)(\\.exe|\\.cmd|\\.bat|\\.ps1)?\\s",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
