{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      { "command": "node ./hooks/core-guard.ts beforeSubmitPrompt", "timeout": 10 }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./hooks/core-guard.ts beforeShellExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node ./hooks/core-guard.ts beforeMCPExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterShellExecution": [
      { "command": "node ./hooks/core-guard.ts afterShellExecution", "timeout": 10 }
    ],
    "afterMCPExecution": [
      { "command": "node ./hooks/core-guard.ts afterMCPExecution", "timeout": 10 }
    ]
  }
}
