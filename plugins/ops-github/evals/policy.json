  { "name": "namespaced plugin server name recognised", "event": "beforeMCPExecution", "input": { "mcp_server_name": "plugin-ops-github-ops-github-write", "tool_name": "github_pr_comment", "tool_input": "{}" }, "expect": { "permission": "ask" } },
  { "name": "privileged merge denied by default", "event": "beforeMCPExecution", "input": { "mcp_server_name": "ops-github-write", "tool_name": "github_pr_merge", "tool_input": "{}" }, "expect": { "permission": "deny" } },
  { "name": "privileged merge asks when enabled", "event": "beforeMCPExecution", "env": { "OPS_ALLOW_PRIVILEGED": "1" }, "input": { "mcp_server_name": "ops-github-write", "tool_name": "github_pr_merge", "tool_input": "{}" }, "expect": { "permission": "ask" } },
  { "name": "write tool on read server denied", "event": "beforeMCPExecution", "input": { "mcp_server_name": "ops-github-read", "tool_name": "github_pr_create", "tool_input": "{}" }, "expect": { "permission": "deny" } },
  { "name": "unknown tool on own server denied", "event": "beforeMCPExecution", "input": { "mcp_server_name": "ops-github-write", "tool_name": "github_repo_delete", "tool_input": "{}" }, "expect": { "permission": "deny" } },
