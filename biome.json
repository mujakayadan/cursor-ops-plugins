{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!templates",
      "!evals/fixtures",
      "!**/lib/core",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noTemplateCurlyInString": "off" }
    },
    "domains": {
      "test": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": { "organizeImports": "on" }
    }
  },
  "overrides": [
    {
      "includes": ["**/evals/*.json"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["**/.cursor-plugin/*.json", "package.json", "plugins/*/mcp.json"],
      "json": { "formatter": { "expand": "always" } }
    },
    {
      "includes": [".release-please-manifest.json"],
      "formatter": { "enabled": false }
    }
  ]
}
