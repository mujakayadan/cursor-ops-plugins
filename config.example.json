{
  "audit": { "enabled": true, "dir": null, "maxFieldChars": 4000 },
  "execution": { "timeoutMs": 120000, "maxOutputChars": 60000 },
  "prompts": { "blockSecrets": true },
  "review": {
    "enabled": true,
    "lenses": { "security": true, "performance": true, "standards": true, "docs": true },
    "maxRounds": 1,
    "minChangedLines": 3,
    "ignore": ["^docs/generated/"]
  },
  "suite": { "disabledPlugins": [] },

  "thirdPartyMcp": {
    "read": "allow",
    "write": "ask",
    "privileged": "ask",
    "unknown": "allow",
    "trustedServers": ["^cursor-ide-browser$"],
    "serverOverrides": {
      "vercel": { "privileged": "deny" }
    }
  },

  "guardrails": {
    "shell": {
      "overrides": {}
    }
  },

  "providers": {
    "github": {
      "allowPrivileged": false,
      "credentials": {
        "read": { "env": {} },
        "write": { "env": {} }
      },
      "scope": { "owners": [] }
    },
    "digitalocean": {
      "allowPrivileged": false,
      "credentials": {
        "read": { "args": [] },
        "write": { "args": [] }
      },
      "scope": { "protectedTags": ["production"] }
    },
    "vercel": {
      "allowPrivileged": false,
      "credentials": {
        "read": { "args": [] },
        "write": { "args": [] }
      },
      "scope": { "teamId": null, "allowedTeams": [] }
    },
    "aws": {
      "allowPrivileged": false,
      "defaultRegion": null,
      "credentials": {
        "read": { "args": [] },
        "write": { "args": [] }
      },
      "scope": { "allowedRegions": [], "allowedAccounts": [] }
    },
    "scaffold": {
      "source": null,
      "ref": null,
      "scope": { "allowedRoots": [] }
    },
    "msgraph": {
      "timeZone": null,
      "scope": { "allowedRecipientDomains": [] }
    },
    "mermaid": {
      "browserPath": null,
      "scope": { "allowedRoots": [] }
    },
    "latex": {
      "engine": null,
      "scope": { "allowedRoots": [] }
    }
  }
}
