name: CI

on:
  push:
    branches: [main, dev]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {{ '${{ github.workflow }}-${{ github.ref }}' }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
{%- if git_lfs %}
        with:
          lfs: true
{%- endif %}
      - uses: astral-sh/setup-uv@v10.3.3
        with:
          enable-cache: true
      - run: uv sync --locked
      - run: uv run prek run --all-files --show-diff-on-failure
        env:
          SKIP: no-commit-to-branch
      - run: uv run pytest
{%- if profile == "library" %}
      - run: uv build
{%- endif %}
