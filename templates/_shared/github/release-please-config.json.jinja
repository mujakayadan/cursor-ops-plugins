{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "{% if language == 'python' %}python{% elif language == 'typescript' %}node{% else %}simple{% endif %}",
      "package-name": {{ project_slug | tojson }},
      "changelog-path": "CHANGELOG.md"{% if language == 'java' %},
      "extra-files": ["build.gradle.kts"]{% endif %}
    }
  }
}
